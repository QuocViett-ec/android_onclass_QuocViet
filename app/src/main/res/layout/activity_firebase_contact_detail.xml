<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/firebase_background"
    tools:context=".FirebaseContactDetailActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_firebase_header"
            android:gravity="center"
            android:text="@string/detail_contact"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            style="@style/FirebaseContactLabel"
            android:text="@string/contact_id" />

        <EditText
            android:id="@+id/edtContactId"
            style="@style/FirebaseContactEditText"
            android:enabled="false"
            android:hint="@string/contact_id"
            android:inputType="text" />

        <TextView
            style="@style/FirebaseContactLabel"
            android:text="@string/name" />

        <EditText
            android:id="@+id/edtName"
            style="@style/FirebaseContactEditText"
            android:hint="@string/name"
            android:inputType="textPersonName" />

        <TextView
            style="@style/FirebaseContactLabel"
            android:text="@string/email" />

        <EditText
            android:id="@+id/edtEmail"
            style="@style/FirebaseContactEditText"
            android:hint="@string/email"
            android:inputType="textEmailAddress" />

        <TextView
            style="@style/FirebaseContactLabel"
            android:text="@string/phone" />

        <EditText
            android:id="@+id/edtPhone"
            style="@style/FirebaseContactEditText"
            android:hint="@string/phone"
            android:inputType="phone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_firebase_button"
                android:text="@string/back"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnUpdate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_firebase_button"
                android:text="@string/update"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnDelete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_firebase_button"
                android:text="@string/delete"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
