<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1628"
    android:orientation="vertical"
    tools:context=".MyUelQueryActivity">

    <!-- ═══════════════════════════════════════════
         HEADER SECTION
         ═══════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="48dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" UEL Assistant"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tra cứu chương trình đào tạo bằng giọng nói hoặc văn bản"
            android:textColor="#B0C4DE"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════
         SEARCH SECTION
         ═══════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="0dp">

        <!-- Search Bar Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Input Field -->
            <EditText
                android:id="@+id/edtQuery"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_field"
                android:drawablePadding="10dp"
                android:hint="VD: học kỳ 1 thương mại điện tử..."
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="#E8F0FE"
                android:textColorHint="#556B85"
                android:textSize="14sp" />

            <!-- Mic Button -->
            <ImageButton
                android:id="@+id/btnVoice"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_mic_button"
                android:contentDescription="Nhập bằng giọng nói"
                android:padding="14dp"
                android:src="@android:drawable/ic_btn_speak_now"
                android:scaleType="fitCenter" />

        </LinearLayout>

        <!-- Hint chips row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="#152032"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text=" Gợi ý:"
                    android:textColor="#5B8DB8"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:background="#1A2E40"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="HK1 TMĐT"
                    android:textColor="#64B5F6"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:background="#1A2E40"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="MIS học kỳ 2"
                    android:textColor="#64B5F6"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:background="#1A2E40"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="AI kỳ 3"
                    android:textColor="#64B5F6"
                    android:textSize="12sp" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Search Button -->
        <Button
            android:id="@+id/btnGetData"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_search_button"
            android:text="  TÌM KIẾM CHƯƠNG TRÌNH"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════
         DIVIDER
         ═══════════════════════════════════════════ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="16dp"
        android:background="#1E3A5F" />

    <!-- Result Label -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <View
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:background="#2196F3" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="KẾT QUẢ TỪ MYUEL"
            android:textColor="#64B5F6"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════
         RESULT CARD
         ═══════════════════════════════════════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_result_card"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/txtResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.5"
            android:padding="20dp"
            android:text=" Kết quả sẽ hiển thị tại đây...\n\nHãy nhập câu hỏi hoặc nhấn  để nói để tìm kiếm chương trình đào tạo."
            android:textColor="#B0C4DE"
            android:textSize="14sp" />
    </ScrollView>

</LinearLayout>
